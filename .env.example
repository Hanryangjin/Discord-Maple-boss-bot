# Windows: register once with python -m maplebot --token-set
DISCORD_TOKEN=
# Optional: sync commands only to a development guild
DISCORD_TEST_GUILD_ID=
MAPLEBOT_DB=var/maplebot.sqlite3
# Optional HTTPS proxy for Discord REST; websocket access is also required.
DISCORD_PROXY=

# Optional per-job overrides; 48 built-in SD face icons need no configuration
MAPLEBOT_JOB_ICONS=assets/jobs

# Optional non-secret JSON config (not loaded from .env automatically)
MAPLEBOT_CONFIG=config.local.json
